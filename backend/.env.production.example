# ─── TalentOrbit Production Environment Template ─────────────────────────────
# Copy this to .env and fill in real values before deploying.
# NEVER commit .env with real secrets to version control.

# Django core
SECRET_KEY=<generate-with: python -c "import secrets; print(secrets.token_urlsafe(64))">
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database — use PostgreSQL in production
DATABASE_URL=postgres://user:password@host:5432/talentorbit

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Frontend base URL (used for Stripe success/cancel redirect URLs)
FRONTEND_URL=https://yourdomain.com

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Use LIVE keys in production (sk_live_..., whsec_...)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ─── JWT Token Lifetimes ──────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7
